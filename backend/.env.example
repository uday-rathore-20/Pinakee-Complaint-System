# Pinakee Complaint & Service Management Platform
# Environment Configuration Template

# Server Port
PORT=5000

# Application Environment (development, test, production)
NODE_ENV=development

# Database Connection URL (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres@localhost:5432/pinakee_complaint_system

# JWT Authentication Secret (Must be >= 16 characters in production)
JWT_SECRET=your_super_secret_jwt_key_min_16_chars_2026
JWT_EXPIRES_IN=24h

# CORS Allowed Origins (Comma-separated list of trusted frontend domains)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Storage Driver ('local' or 's3')
STORAGE_DRIVER=local

# AWS S3 Storage Driver Configuration (Required only if STORAGE_DRIVER=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Production SMTP Email Dispatcher (Optional - defaults to simulator if omitted)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PINakee Support" <noreply@pinakee.com>

# Storage Driver Security (Optional HMAC secret for local storage tokens; defaults to JWT_SECRET if unset)
# STORAGE_HMAC_SECRET=

# API Rate Limiting Thresholds (Optional custom limits per 15-minute window)
# API_RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=100
# UPLOAD_RATE_LIMIT_MAX=120
# COMPLAINT_MUTATION_RATE_LIMIT_MAX=150
